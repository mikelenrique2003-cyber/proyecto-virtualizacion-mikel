# =====================================================================
#  PLANTILLA DE VARIABLES. Copiar a .env y NO subir .env a Git.
#    cp .env.example .env && ./scripts/generar-secretos.sh
#  generar-secretos.sh sustituye cada CAMBIAME por una contraseña
#  aleatoria de 32 caracteres.
# =====================================================================

# --- General ---------------------------------------------------------
DOMINIO=pyme.lan
TZ=Europe/Madrid

# --- Versiones de las imágenes (fijarlas hace el despliegue reproducible)
JOOMLA_TAG=5-apache
GLPI_TAG=latest
NEXTCLOUD_TAG=stable-apache
MARIADB_TAG=11.4
KUMA_TAG=1

# --- Joomla ----------------------------------------------------------
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=joomla_app
JOOMLA_DB_PASSWORD=CAMBIAME
JOOMLA_SITE_NAME="PYME Soluciones"
JOOMLA_ADMIN_NAME="Administrador Web"
JOOMLA_ADMIN_USERNAME=adminweb
JOOMLA_ADMIN_PASSWORD=CAMBIAME
JOOMLA_ADMIN_EMAIL=admin@pyme.lan
# Usuarios de prueba (los crea scripts/joomla-usuarios.sh)
JOOMLA_PASS_EDITOR=CAMBIAME
JOOMLA_PASS_LECTOR=CAMBIAME

# --- GLPI ------------------------------------------------------------
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi_app
GLPI_DB_PASSWORD=CAMBIAME

# --- Nextcloud -------------------------------------------------------
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud_app
NEXTCLOUD_DB_PASSWORD=CAMBIAME
NEXTCLOUD_ADMIN_USER=adminnube
NEXTCLOUD_ADMIN_PASSWORD=CAMBIAME
REDIS_PASSWORD=CAMBIAME
# Usuarios de prueba (los crea scripts/nextcloud-config.sh)
NC_PASS_ANA=CAMBIAME
NC_PASS_LUIS=CAMBIAME

# --- Copias de seguridad ---------------------------------------------
BACKUP_DIR=/var/backups/pyme
BACKUP_RETENCION_DIAS=7
